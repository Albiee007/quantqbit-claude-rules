# Force LF line endings on text files that MUST stay LF cross-platform.
# Windows checkouts will see LF too (no CRLF conversion) — critical for the
# shell scripts which run under bash on Linux/macOS/Git-Bash.

*.sh    text eol=lf
*.ps1   text eol=crlf
*.tmpl  text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf

# Default for everything else.
*       text=auto

# Harness data files — LF everywhere so hashes and diffs are stable.
*.py    text eol=lf
*.tsv   text eol=lf
*.tmpl  text eol=lf
harness/**  text eol=lf
harness/**/*.ps1 text eol=crlf
harness/manifest.tsv linguist-generated=true

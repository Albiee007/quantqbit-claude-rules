// build.gradle.kts (root) — top-level plugin declarations for ${PROJECT_NAME}.
// Versions live in gradle/libs.versions.toml; plugins are applied per-module
// in app/build.gradle.kts. AGP 9 compiles Kotlin itself (built-in Kotlin), so
// there is no org.jetbrains.kotlin.android plugin; the Compose compiler
// plugin's version selects the Kotlin version.

plugins {
    alias(libs.plugins.android.application) apply false
    alias(libs.plugins.kotlin.compose) apply false
    alias(libs.plugins.ktlint) apply false
}

// ----------------------------------------------------------------------------
// checkFileSize — bash scan that WARNS (never fails) on Kotlin files over the
// 500-line cap. Wired after ktlintCheck so it surfaces during normal lint
// runs. Warning-only by design (see project CLAUDE.md).
// ----------------------------------------------------------------------------
tasks.register<Exec>("checkFileSize") {
    description = "Warns on Kotlin files exceeding the 500-line soft cap."
    group = "verification"
    workingDir = rootProject.projectDir
    commandLine("bash", "scripts/check-file-size.sh")
    isIgnoreExitValue = true
}

tasks.named("ktlintCheck") {
    finalizedBy("checkFileSize")
}

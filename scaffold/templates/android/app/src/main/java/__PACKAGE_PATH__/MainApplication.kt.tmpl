package ${ANDROID_PACKAGE}

import android.app.Application
import ${ANDROID_PACKAGE}.core.di.AppGraph

/**
 * Application class — holds the manual DI graph for ${PROJECT_NAME}.
 *
 * No Hilt / Dagger here by design (see project CLAUDE.md / Stack non-goals).
 * Singletons live on [AppGraph]; features pull what they need via
 * `(application as MainApplication).graph`.
 */
class MainApplication : Application() {

    lateinit var graph: AppGraph
        private set

    override fun onCreate() {
        super.onCreate()
        graph = AppGraph(this)
    }
}

# ${PROJECT_NAME} — example environment.
# Copy to .env and fill in real values for local development.
# NEVER commit .env (already covered by .gitignore).

# --- HTTP ---
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# --- Mongo (optional — leave blank to disable) ---
# With the compose stack: mongodb://<MONGO_ROOT_USER>:<MONGO_ROOT_PASSWORD>@localhost:27017/?authSource=admin
# (host `mongo` instead of localhost when the app runs inside compose).
MONGO_URI=

# --- Postgres (optional — leave blank to disable) ---
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# --- docker compose (local databases) ---
# Root credentials for the compose Mongo container. Compose also uses
# POSTGRES_USER / POSTGRES_PASSWORD above for its Postgres container.
# Pick your own values: compose refuses to start while any is empty.
MONGO_ROOT_USER=
MONGO_ROOT_PASSWORD=

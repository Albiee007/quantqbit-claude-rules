#!/usr/bin/env bash
# === ${PROJECT_NAME} SessionStart context hook ===
# Emits SessionStart hook JSON with cwd, git status/branch, and last-activity probe.
set -euo pipefail

# jq is required: manual JSON escaping (sed/awk) does not reliably encode
# control chars, embedded backslashes, or unicode. Exit non-zero so Claude
# Code skips this hook rather than receiving malformed JSON.
if ! command -v jq >/dev/null 2>&1; then
  echo "[FAIL] jq required for SessionStart hook" 1>&2
  exit 1
fi

cwd="$(pwd)"
branch=""
status=""
last_activity=""

if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
  status="$(git status --short 2>/dev/null || true)"
fi

# CODE_SUBDIR is normalised (no trailing slash) by the scaffold engine;
# values are "." or "./<subdir>". Default to "." defensively if empty.
code_dir="${CODE_SUBDIR}"
[ -z "$code_dir" ] && code_dir="."
if [ -e "$code_dir" ]; then
  # GNU stat first, fall back to BSD/macOS stat.
  last_activity="$(stat -c %y "$code_dir" 2>/dev/null \
    || stat -f %Sm "$code_dir" 2>/dev/null \
    || true)"
fi

ctx=${PROJECT_NAME_BASH_QUOTED}" session context
cwd: ${cwd}
git_branch: ${branch:-<none>}
git_status:
${status:-<clean-or-not-a-repo>}
last_activity: ${last_activity:-<unknown>}"

jq -nc --arg c "$ctx" \
  '{hookSpecificOutput: {hookEventName: "SessionStart", additionalContext: $c}}'

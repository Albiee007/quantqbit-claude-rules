{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "plan",
    "additionalDirectories": ["~/.claude/plans/"],
    "allow": [
      "Edit(**/*.env.example)",
      "Write(**/*.env.example)",
      "Edit(**/*.env.template)",
      "Write(**/*.env.template)",
      "Edit(**/templates/env/**)",
      "Write(**/templates/env/**)"
    ],
    "deny": [
      "Edit(**/.env)",
      "Write(**/.env)",
      "Edit(**/.env.*)",
      "Write(**/.env.*)",
      "Bash(git add -A*)",
      "Bash(git add .*)",
      "Bash(git add --all*)",
      "Bash(rm -rf /*)"${DENY_DESTRUCTIVE}${DENY_PUSH_MAIN}
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/session-start-context.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/post-edit-lint.sh"
          }
        ]
      }
    ]
  }
}

# .claude/harness.config — PROJECT-OWNED. Edit freely, then re-run harness sync.
# Written once by the agent harness on first install; never overwritten.

# Which harness content ships to this project (comma list):
#   web     public web app/site      → ui-ux + seo skills and rules
#   mobile  React Native/Expo/Android/iOS → ui-ux skill and rules
#   backend APIs/services            → compose rule
#   infra   Ansible/Terraform/Compose/CI → ansible/terraform/compose rules
#   all     everything
profiles=all

# Verification commands used by the verifier agent (leave empty to auto-detect).
lint_cmd=
typecheck_cmd=
test_cmd=

# Staging/deploy branch that agents must never push to directly.
staging_branch=

# How the file-context hook treats the first UI / SEO file write in each agent
# context: "enforce" denies it once with the checklist and asks the agent to
# load the mandatory skill first (default); "inform" only adds the checklist.
checklists=enforce

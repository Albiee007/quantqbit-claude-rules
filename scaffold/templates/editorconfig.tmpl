# ============================================================
# .editorconfig — workspace-wide editor defaults
# ============================================================
# Conservative root config. UTF-8 + LF + final newline are
# enforced everywhere so cross-platform contributors
# (Windows/macOS/Linux) produce identical output. Per-language
# overrides match upstream norms (4-space Python, 2-space
# YAML/JSON, tab-indented Makefiles).

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{yml,yaml,json,toml}]
indent_style = space
indent_size = 2

[*.py]
indent_style = space
indent_size = 4

[*.sh]
indent_style = space
indent_size = 4
end_of_line = lf

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.mk]
indent_style = tab

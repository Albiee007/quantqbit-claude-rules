{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@/config/*": ["./${SRC_DIR}/config/*"],
      "@/navigation/*": ["./${SRC_DIR}/navigation/*"],
      "@/screens/*": ["./${SRC_DIR}/screens/*"],
      "@/features/*": ["./${SRC_DIR}/features/*"],
      "@/components/*": ["./${SRC_DIR}/components/*"],
      "@/hooks/*": ["./${SRC_DIR}/hooks/*"],
      "@/lib/*": ["./${SRC_DIR}/lib/*"],
      "@/api/*": ["./${SRC_DIR}/api/*"],
      "@/types/*": ["./${SRC_DIR}/types/*"]
    },
    "types": ["jest"]
  },
  "include": ["./${SRC_DIR}/**/*.ts", "${SRC_DIR}/**/*.tsx", "App.tsx", "index.ts"],
  "exclude": ["node_modules", ".expo", "ios", "android", "dist", "build"]
}

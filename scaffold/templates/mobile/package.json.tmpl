{
  "name": "${PROJECT_SLUG}",
  "version": "0.1.0",
  "private": true,
  "description": "${PROJECT_NAME} — mobile (Expo + React Native + TypeScript). Stamped by /init-project-scaffold on ${TIMESTAMP}.",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest --passWithNoTests",
    "lint": "tsc --noEmit && bash scripts/check-file-size.sh",
    "lint:size": "bash scripts/check-file-size.sh",
    "typecheck": "tsc --noEmit",
    "prebuild": "expo prebuild --no-install"
  },
  "dependencies": {
    "expo": "~51.0.0",
    "expo-constants": "~16.0.0",
    "expo-status-bar": "~1.12.0",
    "react": "18.2.0",
    "react-native": "0.74.5",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@tanstack/react-query": "^5.51.0",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "typescript": "~5.3.3",
    "@types/react": "~18.2.79",
    "jest": "^29.7.0",
    "jest-expo": "~51.0.0",
    "@testing-library/react-native": "^12.5.0",
    "@types/jest": "^29.5.12",
    "react-test-renderer": "18.2.0"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|@tanstack/react-query))"
    ]
  }
}

{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "opus",
    "CLAUDE_CODE_SUBAGENT_MODEL_FORCE": "1"
  },
  "permissions": {
    "defaultMode": "plan",
    "deny": [
      "Read(**/.env)",
      "Edit(**/.env)",
      "Write(**/.env)",
      "Read(**/.env.local)",
      "Edit(**/.env.local)",
      "Write(**/.env.local)",
      "Read(**/.env.*.local)",
      "Edit(**/.env.*.local)",
      "Write(**/.env.*.local)",
      "Read(**/.env.production)",
      "Edit(**/.env.production)",
      "Write(**/.env.production)",
      "Read(**/.env.staging)",
      "Edit(**/.env.staging)",
      "Write(**/.env.staging)",
      "Read(**/.env.development)",
      "Edit(**/.env.development)",
      "Write(**/.env.development)",
      "Read(**/.env.test)",
      "Edit(**/.env.test)",
      "Write(**/.env.test)",
      "Bash(git add -A*)",
      "Bash(git add .)",
      "Bash(git add . *)",
      "Bash(git add --all*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/harness/hooks/session-start.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/harness/hooks/prompt-router.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent|Task|Read|Edit|Write|MultiEdit|NotebookEdit|Grep|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/harness/hooks/guard.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/harness/hooks/file-context.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/harness/hooks/post-edit-lint.sh\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "harnesslib/video-providers.schema.json",
  "title": "Generation providers (brand/video/providers.json), schema version 1",
  "description": "The project's own commands for text-to-speech, word alignment and b-roll. Run only by render_video.py generate in the main session; credentials stay in the environment.",
  "type": "object",
  "required": [
    "schemaVersion",
    "providers"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "providers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tts": {
          "type": "object",
          "required": [
            "label",
            "command"
          ],
          "additionalProperties": false,
          "properties": {
            "label": {
              "type": "string",
              "minLength": 2,
              "maxLength": 120,
              "description": "who generates (shown in provenance and disclosure items)"
            },
            "command": {
              "type": "array",
              "minItems": 1,
              "maxItems": 40,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 400
              },
              "description": "argv run from the project root, no shell; placeholders {text} {out} {audio} {prompt} {scene} {language} {casting} {width} {height} {seconds} {fps} {python}"
            },
            "env": {
              "type": "array",
              "maxItems": 10,
              "items": {
                "type": "string",
                "pattern": "^[A-Z_][A-Z0-9_]{0,63}$"
              },
              "description": "environment variables the command needs (names only; values never stored)"
            },
            "terms": {
              "type": "string",
              "maxLength": 300,
              "description": "where the provider's licence or terms for generated media are recorded"
            },
            "timeoutS": {
              "type": "integer",
              "minimum": 10,
              "maximum": 3600
            }
          }
        },
        "align": {
          "type": "object",
          "required": [
            "label",
            "command"
          ],
          "additionalProperties": false,
          "properties": {
            "label": {
              "type": "string",
              "minLength": 2,
              "maxLength": 120,
              "description": "who generates (shown in provenance and disclosure items)"
            },
            "command": {
              "type": "array",
              "minItems": 1,
              "maxItems": 40,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 400
              },
              "description": "argv run from the project root, no shell; placeholders {text} {out} {audio} {prompt} {scene} {language} {casting} {width} {height} {seconds} {fps} {python}"
            },
            "env": {
              "type": "array",
              "maxItems": 10,
              "items": {
                "type": "string",
                "pattern": "^[A-Z_][A-Z0-9_]{0,63}$"
              },
              "description": "environment variables the command needs (names only; values never stored)"
            },
            "terms": {
              "type": "string",
              "maxLength": 300,
              "description": "where the provider's licence or terms for generated media are recorded"
            },
            "timeoutS": {
              "type": "integer",
              "minimum": 10,
              "maximum": 3600
            }
          }
        },
        "broll": {
          "type": "object",
          "required": [
            "label",
            "command"
          ],
          "additionalProperties": false,
          "properties": {
            "label": {
              "type": "string",
              "minLength": 2,
              "maxLength": 120,
              "description": "who generates (shown in provenance and disclosure items)"
            },
            "command": {
              "type": "array",
              "minItems": 1,
              "maxItems": 40,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 400
              },
              "description": "argv run from the project root, no shell; placeholders {text} {out} {audio} {prompt} {scene} {language} {casting} {width} {height} {seconds} {fps} {python}"
            },
            "env": {
              "type": "array",
              "maxItems": 10,
              "items": {
                "type": "string",
                "pattern": "^[A-Z_][A-Z0-9_]{0,63}$"
              },
              "description": "environment variables the command needs (names only; values never stored)"
            },
            "terms": {
              "type": "string",
              "maxLength": 300,
              "description": "where the provider's licence or terms for generated media are recorded"
            },
            "timeoutS": {
              "type": "integer",
              "minimum": 10,
              "maximum": 3600
            }
          }
        }
      }
    }
  }
}

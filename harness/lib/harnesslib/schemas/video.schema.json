{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "harnesslib/video.schema.json",
  "title": "Video piece (brand/video/<id>/video.json), schema version 1",
  "description": "One video: its formats, scenes (template, timing, on-screen copy, voice-over line) and voice direction. The look and motion come from the selected video concept; the piece never sets colours or fonts. Times are seconds and become whole frames (frames = floor(seconds * fps + 0.5)).",
  "type": "object",
  "required": ["schemaVersion", "id", "kind", "formats", "fps", "scenes"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,39}$" },
    "kind": { "enum": ["social"] },
    "title": { "type": "string", "maxLength": 120 },
    "formats": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["social-9x16"] } },
    "fps": { "enum": [24, 25, 30, 60] },
    "concept": { "type": "string", "format": "relpath", "description": "a video concept for previews; production always uses the approved, selected one" },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "x-uniqueKey": "id",
      "items": { "$ref": "#/$defs/scene" }
    },
    "voice": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "language": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$" },
        "casting": { "type": "string", "minLength": 3, "maxLength": 200 },
        "delivery": { "type": "string", "maxLength": 300 },
        "pronunciations": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "object",
            "required": ["text", "say"],
            "additionalProperties": false,
            "properties": {
              "text": { "type": "string", "minLength": 1, "maxLength": 60 },
              "say": { "type": "string", "minLength": 1, "maxLength": 80 }
            }
          }
        }
      }
    },
    "captions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sidecar": { "type": "array", "uniqueItems": true, "items": { "enum": ["srt", "vtt"] } },
        "maxCharsPerLine": { "type": "integer", "minimum": 16, "maximum": 42 }
      }
    }
  },
  "$defs": {
    "copyText": { "type": "string", "maxLength": 160 },
    "scene": {
      "type": "object",
      "required": ["id", "template", "duration"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,39}$" },
        "template": { "enum": ["title", "feature", "stat", "end-card"] },
        "duration": { "type": "number", "minimum": 0.5, "maximum": 60, "description": "seconds on screen, including the hold; an incoming transition overlaps this scene's tail" },
        "hold": { "type": "number", "minimum": 0, "maximum": 60, "description": "the still tail (reading time, contrast probes); default: everything after the scene's entrance" },
        "transitionIn": {
          "type": "object",
          "required": ["type"],
          "additionalProperties": false,
          "properties": {
            "type": { "enum": ["cut", "fade", "dip", "slide", "push", "scale", "wipe"] },
            "duration": { "type": "number", "minimum": 0, "maximum": 3 }
          }
        },
        "layout": { "enum": ["type-start", "type-center", "type-lower"] },
        "background": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,23}$" },
        "copy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kicker": { "$ref": "#/$defs/copyText" },
            "head": { "$ref": "#/$defs/copyText" },
            "sub": { "type": "string", "maxLength": 240 },
            "points": { "type": "array", "maxItems": 5, "items": { "type": "string", "minLength": 1, "maxLength": 80 } },
            "value": { "type": "string", "minLength": 1, "maxLength": 12 },
            "label": { "type": "string", "maxLength": 80 },
            "url": { "type": "string", "maxLength": 80 }
          }
        },
        "vo": { "type": "string", "maxLength": 600, "description": "the voice-over line for this scene (written to the script; no audio is made by default)" }
      }
    }
  }
}

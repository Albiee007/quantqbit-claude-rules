{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "harnesslib/video.schema.json",
  "title": "Video piece (brand/video/<id>/video.json), schema version 1",
  "description": "One video: its formats, scenes (template, timing, on-screen copy, voice-over line) and voice direction. The look and motion come from the selected video concept; the piece never sets colours or fonts. Times are seconds and become whole frames (frames = floor(seconds * fps + 0.5)).",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "kind",
    "formats",
    "fps",
    "scenes"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
    },
    "kind": {
      "enum": [
        "social",
        "loop",
        "explainer",
        "app-preview"
      ],
      "description": "social: a promo clip; loop: made to repeat (GIF/WebP by default, loop-seam signal); explainer: a longer piece, usually with voice and music; app-preview: an App Store preview, mostly screen recordings"
    },
    "title": {
      "type": "string",
      "maxLength": 120
    },
    "formats": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/formatId"
      },
      "description": "built-in formats (social-9x16, social-4x5, social-1x1, wide-16x9, og-card, app-preview-iphone, app-preview-ipad) or ids declared in customFormats; every format shares one timeline; scenes may change layout and copy per format with byFormat"
    },
    "customFormats": {
      "type": "object",
      "description": "the piece's own formats: any even size, like a built-in format (length range, encoding, type scale and safe insets come from it, the insets scaled to the size)",
      "propertyNames": {
        "$ref": "#/$defs/formatId"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "size",
          "like"
        ],
        "additionalProperties": false,
        "properties": {
          "size": {
            "type": "string",
            "pattern": "^[1-9][0-9]{2,3}x[1-9][0-9]{2,3}$",
            "description": "WxH, both even, each side 128-3840 px"
          },
          "like": {
            "enum": [
              "social-9x16",
              "social-4x5",
              "social-1x1",
              "wide-16x9",
              "og-card"
            ]
          },
          "label": {
            "type": "string",
            "maxLength": 120
          },
          "min": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "max": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "typeScale": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 4
          },
          "profile": {
            "enum": [
              "h264-web"
            ]
          },
          "safe": {
            "type": "object",
            "additionalProperties": false,
            "description": "pixels at this format's size, merged over the scaled insets of the format it is like",
            "properties": {
              "standard": {
                "$ref": "#/$defs/insets"
              },
              "strict": {
                "$ref": "#/$defs/insets"
              }
            }
          }
        }
      }
    },
    "fps": {
      "enum": [
        24,
        25,
        30,
        60
      ]
    },
    "concept": {
      "type": "string",
      "format": "relpath",
      "description": "a video concept for previews; production always uses the approved, selected one"
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "x-uniqueKey": "id",
      "items": {
        "$ref": "#/$defs/scene"
      }
    },
    "libraries": {
      "type": "array",
      "maxItems": 8,
      "description": "animation libraries the project supplies for custom scenes (GSAP, lottie-web...): local files with their licence, loaded before the scenes; never fetched, never vendored by the harness",
      "items": {
        "type": "object",
        "required": [
          "file",
          "name",
          "license"
        ],
        "additionalProperties": false,
        "properties": {
          "file": {
            "type": "string",
            "format": "relpath",
            "pattern": "\\.m?js$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "license": {
            "type": "string",
            "minLength": 3,
            "maxLength": 300
          }
        }
      }
    },
    "loop": {
      "type": "object",
      "additionalProperties": false,
      "description": "animated outputs derived from the master video of each format (pieces up to 15 s)",
      "properties": {
        "outputs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "gif",
              "webp"
            ]
          }
        },
        "width": {
          "type": "integer",
          "minimum": 120,
          "maximum": 1200,
          "description": "pixels; default 600 (never wider than the format)"
        },
        "fps": {
          "type": "integer",
          "minimum": 5,
          "maximum": 30,
          "description": "must divide the piece's fps; default 15"
        },
        "maxBytes": {
          "type": "integer",
          "minimum": 100000,
          "maximum": 50000000,
          "description": "a larger file is a REVIEW REQUIRED item; default 5 MB"
        }
      }
    },
    "poster": {
      "type": "object",
      "required": [
        "scene"
      ],
      "additionalProperties": false,
      "description": "a still PNG per format: the scene's still frame",
      "properties": {
        "scene": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
        }
      }
    },
    "transparent": {
      "type": "boolean",
      "description": "an overlay with an alpha channel (lower thirds, stingers): no canvas, scene backgrounds or motif; encoded with the alpha profile instead of H.264"
    },
    "alpha": {
      "enum": [
        "webm",
        "prores"
      ],
      "description": "transparent pieces: VP9 with alpha in WebM (default) or ProRes 4444 in QuickTime"
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "description": "sound mixed into the video (never part of the storyboard approval; the owner approves the mix separately)",
      "properties": {
        "voice": {
          "type": "boolean",
          "description": "mix the recorded voice-over: one take per scene with a vo line, brand/video/<id>/media/vo/<scene>.wav (or .flac, .m4a, .mp3)"
        },
        "music": {
          "type": "object",
          "required": [
            "file",
            "license"
          ],
          "additionalProperties": false,
          "properties": {
            "file": {
              "type": "string",
              "format": "relpath"
            },
            "license": {
              "type": "string",
              "minLength": 3,
              "maxLength": 300,
              "description": "the licence and where it is recorded (track, library, licence id)"
            },
            "gainDb": {
              "type": "number",
              "minimum": -40,
              "maximum": 0,
              "description": "music level before the mix is normalised; default -18"
            },
            "duck": {
              "type": "boolean",
              "description": "lower the music while someone speaks (default true)"
            }
          }
        },
        "loudness": {
          "enum": [
            "web",
            "broadcast"
          ],
          "description": "web: -16 LUFS (default); broadcast: -23 LUFS (EBU R128); true peak -2 dBTP"
        }
      }
    },
    "voice": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "language": {
          "type": "string",
          "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
        },
        "casting": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200
        },
        "delivery": {
          "type": "string",
          "maxLength": 300
        },
        "pronunciations": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "object",
            "required": [
              "text",
              "say"
            ],
            "additionalProperties": false,
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60
              },
              "say": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              }
            }
          }
        }
      }
    },
    "captions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sidecar": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "srt",
              "vtt"
            ]
          }
        },
        "maxCharsPerLine": {
          "type": "integer",
          "minimum": 16,
          "maximum": 42
        }
      }
    }
  },
  "$defs": {
    "formatId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,39}$",
      "description": "a built-in format or one declared in customFormats (checked when the piece loads)"
    },
    "insets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "top": {
          "type": "integer",
          "minimum": 0
        },
        "right": {
          "type": "integer",
          "minimum": 0
        },
        "bottom": {
          "type": "integer",
          "minimum": 0
        },
        "left": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "copyText": {
      "type": "string",
      "maxLength": 160
    },
    "scene": {
      "type": "object",
      "required": [
        "id",
        "template",
        "duration"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
        },
        "template": {
          "enum": [
            "title",
            "feature",
            "stat",
            "end-card",
            "still",
            "recording",
            "custom"
          ]
        },
        "duration": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 60,
          "description": "seconds on screen, including the hold; an incoming transition overlaps this scene's tail"
        },
        "hold": {
          "type": "number",
          "minimum": 0,
          "maximum": 60,
          "description": "the still tail (reading time, contrast probes); default: everything after the scene's entrance"
        },
        "transitionIn": {
          "type": "object",
          "required": [
            "type"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "enum": [
                "cut",
                "fade",
                "dip",
                "slide",
                "push",
                "scale",
                "wipe"
              ]
            },
            "duration": {
              "type": "number",
              "minimum": 0,
              "maximum": 3
            }
          }
        },
        "layout": {
          "enum": [
            "type-start",
            "type-center",
            "type-lower"
          ]
        },
        "background": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,23}$"
        },
        "copy": {
          "$ref": "#/$defs/copy"
        },
        "media": {
          "type": "object",
          "additionalProperties": false,
          "description": "still scenes: the picture (image); recording scenes: the screen recording (video). The bytes are part of the storyboard approval",
          "properties": {
            "image": {
              "type": "string",
              "format": "relpath",
              "pattern": "\\.([Pp][Nn][Gg]|[Jj][Pp][Ee]?[Gg]|[Ww][Ee][Bb][Pp]|[Ss][Vv][Gg])$"
            },
            "video": {
              "type": "string",
              "format": "relpath",
              "pattern": "\\.([Mm][Pp]4|[Mm][Oo][Vv]|[Mm]4[Vv]|[Ww][Ee][Bb][Mm])$",
              "description": "a screen recording captured from the app (mobile-screen-capture), shown frame by frame"
            },
            "from": {
              "type": "number",
              "minimum": 0,
              "maximum": 3600,
              "description": "recording scenes: seconds into the recording where the scene starts (default 0)"
            },
            "fit": {
              "enum": [
                "cover",
                "contain"
              ]
            },
            "motion": {
              "enum": [
                "none",
                "push-in",
                "pull-out",
                "pan-left",
                "pan-right"
              ],
              "description": "a slow, linear move over the whole scene"
            },
            "focus": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "description": "the point kept in view and zoomed towards, [x, y] from the top left"
            },
            "license": {
              "type": "string",
              "minLength": 3,
              "maxLength": 300,
              "description": "where the picture comes from and why the project may use it (required in spirit for anything not made for the project)"
            },
            "prompt": {
              "type": "string",
              "minLength": 3,
              "maxLength": 1000,
              "description": "b-roll: what render_video.py generate --what broll asks the project's provider for; it writes the file named by video or image"
            }
          }
        },
        "custom": {
          "type": "object",
          "required": [
            "script"
          ],
          "additionalProperties": false,
          "description": "a scene of the project's own: an HTML fragment and a script that registers window.VideoScenes[<scene id>] = (el, ctx) => player; Web Animations or a returned library player (a paused GSAP timeline, a Lottie animation) are seeked frame by frame",
          "properties": {
            "html": {
              "type": "string",
              "format": "relpath",
              "pattern": "\\.html?$"
            },
            "script": {
              "type": "string",
              "format": "relpath",
              "pattern": "\\.m?js$"
            },
            "lottie": {
              "type": "string",
              "format": "relpath",
              "pattern": "\\.json$",
              "description": "Lottie animation data, passed to the script as ctx.lottie"
            },
            "assets": {
              "type": "object",
              "maxProperties": 16,
              "description": "the project's images the scene composes (layers, plates, inserts), by name; passed to the script as ctx.assets {name: page path} and decoded before capture",
              "propertyNames": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,31}$"
              },
              "additionalProperties": {
                "type": "object",
                "required": [
                  "file"
                ],
                "additionalProperties": false,
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "relpath",
                    "pattern": "\\.([Pp][Nn][Gg]|[Jj][Pp][Ee]?[Gg]|[Ww][Ee][Bb][Pp]|[Ss][Vv][Gg])$"
                  },
                  "license": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 300,
                    "description": "where a picture not made for the project comes from and that the project may use it"
                  }
                }
              }
            }
          }
        },
        "byFormat": {
          "type": "object",
          "description": "per-format changes to layout and copy (never timing)",
          "propertyNames": {
            "$ref": "#/$defs/formatId"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "layout": {
                "enum": [
                  "type-start",
                  "type-center",
                  "type-lower"
                ]
              },
              "copy": {
                "$ref": "#/$defs/copy"
              },
              "hide": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "kicker",
                    "head",
                    "sub",
                    "points",
                    "label",
                    "url"
                  ]
                }
              }
            }
          }
        },
        "vo": {
          "type": "string",
          "maxLength": 600,
          "description": "the voice-over line for this scene (written to the script; no audio is made by default)"
        }
      }
    },
    "copy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kicker": {
          "$ref": "#/$defs/copyText"
        },
        "head": {
          "$ref": "#/$defs/copyText"
        },
        "sub": {
          "type": "string",
          "maxLength": 240
        },
        "points": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12
        },
        "label": {
          "type": "string",
          "maxLength": 80
        },
        "url": {
          "type": "string",
          "maxLength": 80
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "harnesslib/video.schema.json",
  "title": "Video piece (brand/video/<id>/video.json), schema version 1",
  "description": "One video: its formats, scenes (template, timing, on-screen copy, voice-over line) and voice direction. The look and motion come from the selected video concept; the piece never sets colours or fonts. Times are seconds and become whole frames (frames = floor(seconds * fps + 0.5)).",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "kind",
    "formats",
    "fps",
    "scenes"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
    },
    "kind": {
      "enum": [
        "social",
        "loop"
      ],
      "description": "social: a promo clip; loop: a short piece meant to repeat (GIF/WebP loop by default, loop-seam signal)"
    },
    "title": {
      "type": "string",
      "maxLength": 120
    },
    "formats": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "social-9x16",
          "social-4x5",
          "social-1x1",
          "wide-16x9",
          "og-card"
        ]
      },
      "description": "every format shares one timeline; scenes may change layout and copy per format with byFormat"
    },
    "fps": {
      "enum": [
        24,
        25,
        30,
        60
      ]
    },
    "concept": {
      "type": "string",
      "format": "relpath",
      "description": "a video concept for previews; production always uses the approved, selected one"
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "x-uniqueKey": "id",
      "items": {
        "$ref": "#/$defs/scene"
      }
    },
    "loop": {
      "type": "object",
      "additionalProperties": false,
      "description": "animated outputs derived from the master video of each format (pieces up to 15 s)",
      "properties": {
        "outputs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "gif",
              "webp"
            ]
          }
        },
        "width": {
          "type": "integer",
          "minimum": 120,
          "maximum": 1200,
          "description": "pixels; default 600 (never wider than the format)"
        },
        "fps": {
          "type": "integer",
          "minimum": 5,
          "maximum": 30,
          "description": "must divide the piece's fps; default 15"
        },
        "maxBytes": {
          "type": "integer",
          "minimum": 100000,
          "maximum": 50000000,
          "description": "a larger file is a REVIEW REQUIRED item; default 5 MB"
        }
      }
    },
    "poster": {
      "type": "object",
      "required": [
        "scene"
      ],
      "additionalProperties": false,
      "description": "a still PNG per format: the scene's still frame",
      "properties": {
        "scene": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
        }
      }
    },
    "voice": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "language": {
          "type": "string",
          "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
        },
        "casting": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200
        },
        "delivery": {
          "type": "string",
          "maxLength": 300
        },
        "pronunciations": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "object",
            "required": [
              "text",
              "say"
            ],
            "additionalProperties": false,
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60
              },
              "say": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              }
            }
          }
        }
      }
    },
    "captions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sidecar": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "srt",
              "vtt"
            ]
          }
        },
        "maxCharsPerLine": {
          "type": "integer",
          "minimum": 16,
          "maximum": 42
        }
      }
    }
  },
  "$defs": {
    "copyText": {
      "type": "string",
      "maxLength": 160
    },
    "scene": {
      "type": "object",
      "required": [
        "id",
        "template",
        "duration"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
        },
        "template": {
          "enum": [
            "title",
            "feature",
            "stat",
            "end-card",
            "still"
          ]
        },
        "duration": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 60,
          "description": "seconds on screen, including the hold; an incoming transition overlaps this scene's tail"
        },
        "hold": {
          "type": "number",
          "minimum": 0,
          "maximum": 60,
          "description": "the still tail (reading time, contrast probes); default: everything after the scene's entrance"
        },
        "transitionIn": {
          "type": "object",
          "required": [
            "type"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "enum": [
                "cut",
                "fade",
                "dip",
                "slide",
                "push",
                "scale",
                "wipe"
              ]
            },
            "duration": {
              "type": "number",
              "minimum": 0,
              "maximum": 3
            }
          }
        },
        "layout": {
          "enum": [
            "type-start",
            "type-center",
            "type-lower"
          ]
        },
        "background": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,23}$"
        },
        "copy": {
          "$ref": "#/$defs/copy"
        },
        "media": {
          "type": "object",
          "required": [
            "image"
          ],
          "additionalProperties": false,
          "description": "the picture a still scene shows (its bytes are part of the storyboard approval)",
          "properties": {
            "image": {
              "type": "string",
              "format": "relpath",
              "pattern": "\\.([Pp][Nn][Gg]|[Jj][Pp][Ee]?[Gg]|[Ww][Ee][Bb][Pp]|[Ss][Vv][Gg])$"
            },
            "fit": {
              "enum": [
                "cover",
                "contain"
              ]
            },
            "motion": {
              "enum": [
                "none",
                "push-in",
                "pull-out",
                "pan-left",
                "pan-right"
              ],
              "description": "a slow, linear move over the whole scene"
            },
            "focus": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "description": "the point kept in view and zoomed towards, [x, y] from the top left"
            },
            "license": {
              "type": "string",
              "minLength": 3,
              "maxLength": 300,
              "description": "where the picture comes from and why the project may use it (required in spirit for anything not made for the project)"
            }
          }
        },
        "byFormat": {
          "type": "object",
          "description": "per-format changes to layout and copy (never timing)",
          "propertyNames": {
            "enum": [
              "social-9x16",
              "social-4x5",
              "social-1x1",
              "wide-16x9",
              "og-card"
            ]
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "layout": {
                "enum": [
                  "type-start",
                  "type-center",
                  "type-lower"
                ]
              },
              "copy": {
                "$ref": "#/$defs/copy"
              },
              "hide": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "kicker",
                    "head",
                    "sub",
                    "points",
                    "label",
                    "url"
                  ]
                }
              }
            }
          }
        },
        "vo": {
          "type": "string",
          "maxLength": 600,
          "description": "the voice-over line for this scene (written to the script; no audio is made by default)"
        }
      }
    },
    "copy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kicker": {
          "$ref": "#/$defs/copyText"
        },
        "head": {
          "$ref": "#/$defs/copyText"
        },
        "sub": {
          "type": "string",
          "maxLength": 240
        },
        "points": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12
        },
        "label": {
          "type": "string",
          "maxLength": 80
        },
        "url": {
          "type": "string",
          "maxLength": 80
        }
      }
    }
  }
}

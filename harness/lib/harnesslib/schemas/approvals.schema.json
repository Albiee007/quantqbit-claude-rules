{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "harnesslib/approvals.schema.json",
  "title": "Owner approval records (brand/approvals.json), schema version 1",
  "description": "Written only by 'direction.py approve', run by the main session after the owner decides. Each record binds a gate to the exact content hash and resolved-input hash it approved; any change to either makes the record stale.",
  "type": "object",
  "required": ["schemaVersion", "records"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "records": {
      "type": "array",
      "x-uniqueKey": "id",
      "items": {
        "type": "object",
        "required": ["id", "gate", "subject", "hash", "inputs", "by", "evidence", "at", "recordedBy"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[0-9]{8}-[0-9]{6}-[0-9a-f]{6}$" },
          "gate": { "enum": ["direction", "concept", "exception", "storyboard", "mix", "review"] },
          "family": { "enum": ["store", "marketing", "icon", "illustration", "video"] },
          "subject": { "type": "string", "format": "relpath" },
          "scope": { "type": "string", "maxLength": 200 },
          "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "inputs": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "by": { "type": "string", "minLength": 1, "maxLength": 80 },
          "evidence": { "type": "string", "minLength": 3, "maxLength": 500 },
          "at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
          "recordedBy": { "type": "string", "minLength": 1, "maxLength": 80 },
          "hashVersion": { "type": "integer", "minimum": 1, "maximum": 2, "description": "missing = 1 (the 1.7 hashing); see harnesslib/direction.py" },
          "parts": {
            "type": "object",
            "description": "storyboard: hashes of the piece's parts, so a stale record can say what changed",
            "additionalProperties": false,
            "properties": {
              "visual": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "timing": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "script": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "media": { "type": "string", "pattern": "^[0-9a-f]{64}$", "description": "the bytes of the images the scenes show" }
            }
          },
          "run": { "type": "string", "pattern": "^[0-9]{8}-[0-9]{6}-[0-9a-f]{6}$", "description": "review: the run whose outputs the owner looked at" },
          "items": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9:._-]{0,119}$" }, "description": "review: the REVIEW REQUIRED items the owner acknowledged" }
        }
      }
    }
  }
}

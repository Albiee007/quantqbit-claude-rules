{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "harnesslib/concept.schema.json",
  "title": "Media concept (brand/concepts/<family>/<run>/<id>.json), schema version 1",
  "description": "One creative alternative for one asset family. 'spec' is validated against the family's definition below; colour fields are token references (direction roles as {roles.<name>}).",
  "type": "object",
  "required": ["schemaVersion", "family", "id", "run", "name", "idea", "spec", "preview"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "family": { "enum": ["store", "marketing", "icon", "illustration", "video"] },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,39}$" },
    "run": { "type": "string", "pattern": "^[0-9]{8}-[0-9]{6}-[0-9a-f]{6}$" },
    "author": { "type": "string", "maxLength": 80 },
    "name": { "type": "string", "minLength": 2, "maxLength": 80 },
    "idea": { "type": "string", "minLength": 10, "maxLength": 400 },
    "levers": { "type": "array", "maxItems": 10, "items": { "type": "string", "minLength": 2, "maxLength": 160 } },
    "risks": { "type": "array", "maxItems": 10, "items": { "type": "string", "minLength": 2, "maxLength": 200 } },
    "spec": { "type": "object" },
    "preview": {
      "oneOf": [
        {
          "type": "object",
          "required": ["path", "sha256"],
          "additionalProperties": false,
          "properties": {
            "path": { "type": "string", "format": "relpath" },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        },
        {
          "type": "object",
          "required": ["unavailable"],
          "additionalProperties": false,
          "properties": { "unavailable": { "type": "string", "minLength": 3, "maxLength": 300 } }
        }
      ]
    }
  },
  "$defs": {
    "colorRef": { "type": "string", "pattern": "^\\{[A-Za-z0-9_$-]+(\\.[A-Za-z0-9_$-]+)*\\}$" },
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,23}$" },
    "background": {
      "type": "object",
      "required": ["recipe", "text"],
      "additionalProperties": false,
      "properties": {
        "recipe": { "enum": ["solid", "linear"] },
        "color": { "$ref": "#/$defs/colorRef" },
        "stops": { "type": "array", "minItems": 2, "maxItems": 5, "items": { "$ref": "#/$defs/colorRef" } },
        "angle": { "type": "number", "minimum": 0, "maximum": 360 },
        "space": { "enum": ["oklab", "srgb"] },
        "panel": { "$ref": "#/$defs/colorRef" },
        "text": {
          "type": "object",
          "required": ["head", "sub"],
          "additionalProperties": false,
          "properties": {
            "head": { "$ref": "#/$defs/colorRef" },
            "sub": { "$ref": "#/$defs/colorRef" },
            "accent": { "$ref": "#/$defs/colorRef" },
            "onAccent": { "$ref": "#/$defs/colorRef" }
          }
        }
      }
    },
    "backgrounds": {
      "type": "object",
      "propertyNames": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,23}$" },
      "additionalProperties": { "$ref": "#/$defs/background" }
    },
    "textStyle": {
      "type": "object",
      "required": ["font", "weight"],
      "additionalProperties": false,
      "properties": {
        "font": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]{0,31}$" },
        "weight": { "type": "number", "minimum": 100, "maximum": 1000 },
        "italic": { "type": "boolean" },
        "tracking": { "type": "number", "minimum": -0.1, "maximum": 0.3 },
        "lineHeight": { "type": "number", "minimum": 0.8, "maximum": 2 },
        "case": { "enum": ["as-written", "upper"] }
      }
    },
    "caption": {
      "type": "object",
      "required": ["head", "sub", "align"],
      "additionalProperties": false,
      "properties": {
        "head": { "$ref": "#/$defs/textStyle" },
        "sub": { "$ref": "#/$defs/textStyle" },
        "kicker": { "$ref": "#/$defs/textStyle" },
        "align": { "enum": ["start", "center"] },
        "accent": { "enum": ["color", "underline", "highlight", "none"] },
        "headScale": { "type": "number", "minimum": 0.03, "maximum": 0.14 },
        "subRatio": { "type": "number", "minimum": 0.3, "maximum": 0.8 }
      }
    },
    "device": {
      "type": "object",
      "required": ["style"],
      "additionalProperties": false,
      "properties": {
        "style": { "enum": ["frame", "frameless"] },
        "bezel": { "$ref": "#/$defs/colorRef" },
        "radius": { "type": "number", "minimum": 0, "maximum": 0.2 },
        "shadow": { "enum": ["none", "soft", "long", "crisp"] }
      }
    },
    "motifUse": {
      "type": "object",
      "required": ["use"],
      "additionalProperties": false,
      "properties": {
        "use": { "type": "boolean" },
        "opacity": { "type": "number", "minimum": 0.02, "maximum": 1 },
        "placement": { "enum": ["corner", "edge", "behind-device"] },
        "scale": { "type": "number", "minimum": 0.1, "maximum": 2 }
      }
    },
    "storeSpec": {
      "type": "object",
      "required": ["backgrounds", "caption", "device", "layouts", "defaultLayout", "defaultBackground"],
      "additionalProperties": false,
      "properties": {
        "backgrounds": { "$ref": "#/$defs/backgrounds" },
        "caption": { "$ref": "#/$defs/caption" },
        "device": { "$ref": "#/$defs/device" },
        "layouts": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["caption-top", "caption-bottom", "split-left", "split-right", "inset"] } },
        "defaultLayout": { "enum": ["caption-top", "caption-bottom", "split-left", "split-right", "inset"] },
        "defaultBackground": { "$ref": "#/$defs/name" },
        "motif": { "$ref": "#/$defs/motifUse" },
        "displayWidth": { "type": "number", "minimum": 120, "maximum": 2000 },
        "featureGraphic": {
          "type": "object",
          "required": ["layout", "background"],
          "additionalProperties": false,
          "properties": {
            "layout": { "enum": ["split-device-right", "split-device-left", "centered-type"] },
            "background": { "$ref": "#/$defs/name" }
          }
        }
      }
    },
    "marketingSpec": {
      "type": "object",
      "required": ["backgrounds", "caption", "layouts", "defaultLayout", "defaultBackground"],
      "additionalProperties": false,
      "properties": {
        "backgrounds": { "$ref": "#/$defs/backgrounds" },
        "caption": { "$ref": "#/$defs/caption" },
        "layouts": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["type-start", "type-center", "split-image", "logo-band"] } },
        "defaultLayout": { "enum": ["type-start", "type-center", "split-image", "logo-band"] },
        "defaultBackground": { "$ref": "#/$defs/name" },
        "logo": { "type": "string", "format": "relpath", "pattern": "\\.(svg|png)$" },
        "motif": { "$ref": "#/$defs/motifUse" },
        "displayWidth": { "type": "number", "minimum": 120, "maximum": 2000 }
      }
    },
    "iconSpec": {
      "type": "object",
      "required": ["background", "glyphScale"],
      "additionalProperties": false,
      "properties": {
        "background": {
          "type": "object",
          "required": ["recipe"],
          "additionalProperties": false,
          "properties": {
            "recipe": { "enum": ["solid", "linear"] },
            "color": { "$ref": "#/$defs/colorRef" },
            "stops": { "type": "array", "minItems": 2, "maxItems": 3, "items": { "$ref": "#/$defs/colorRef" } },
            "angle": { "type": "number", "minimum": 0, "maximum": 360 },
            "space": { "enum": ["oklab", "srgb"] }
          }
        },
        "glyphScale": { "type": "number", "minimum": 0.3, "maximum": 0.8 },
        "glyphOffset": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number", "minimum": -0.1, "maximum": 0.1 } },
        "qualityTarget": {
          "type": "object",
          "required": ["markContrast"],
          "additionalProperties": false,
          "properties": { "markContrast": { "type": "number", "minimum": 1, "maximum": 21 } }
        }
      }
    },
    "videoLayout": { "enum": ["type-start", "type-center", "type-lower"] },
    "transition": { "enum": ["cut", "fade", "dip", "slide", "push", "scale", "wipe"] },
    "textMotion": { "enum": ["fade-up", "mask-up", "word-stagger", "scale-in", "fade", "none"] },
    "videoSpec": {
      "type": "object",
      "description": "The look and motion of a project's videos. The look reuses the still families' building blocks; motion values are token references ($type duration and cubicBezier) kept in the token file with everything else.",
      "required": ["backgrounds", "caption", "layouts", "defaultLayout", "defaultBackground", "motion", "pace"],
      "additionalProperties": false,
      "properties": {
        "backgrounds": { "$ref": "#/$defs/backgrounds" },
        "caption": { "$ref": "#/$defs/caption" },
        "layouts": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/videoLayout" } },
        "defaultLayout": { "$ref": "#/$defs/videoLayout" },
        "defaultBackground": { "$ref": "#/$defs/name" },
        "logo": { "type": "string", "format": "relpath", "pattern": "\\.(svg|png)$" },
        "motif": { "$ref": "#/$defs/motifUse" },
        "displayWidth": { "type": "number", "minimum": 120, "maximum": 2000 },
        "motion": {
          "type": "object",
          "required": ["durations", "easing", "transitions", "defaultTransition", "textIn"],
          "additionalProperties": false,
          "properties": {
            "durations": {
              "type": "object",
              "required": ["fast", "base", "slow"],
              "additionalProperties": false,
              "properties": {
                "fast": { "$ref": "#/$defs/colorRef" },
                "base": { "$ref": "#/$defs/colorRef" },
                "slow": { "$ref": "#/$defs/colorRef" }
              }
            },
            "easing": {
              "type": "object",
              "required": ["standard", "enter", "exit"],
              "additionalProperties": false,
              "properties": {
                "standard": { "$ref": "#/$defs/colorRef" },
                "enter": { "$ref": "#/$defs/colorRef" },
                "exit": { "$ref": "#/$defs/colorRef" },
                "emphasis": { "$ref": "#/$defs/colorRef" }
              }
            },
            "stagger": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "perItemMs": { "type": "number", "minimum": 0, "maximum": 150 },
                "maxItems": { "type": "integer", "minimum": 1, "maximum": 8 }
              }
            },
            "transitions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/transition" } },
            "defaultTransition": { "$ref": "#/$defs/transition" },
            "textIn": { "$ref": "#/$defs/textMotion" },
            "textOut": { "$ref": "#/$defs/textMotion" },
            "motifMotion": { "enum": ["none", "drift", "pulse"] }
          }
        },
        "pace": {
          "type": "object",
          "required": ["readingWpm", "minHold"],
          "additionalProperties": false,
          "properties": {
            "readingWpm": { "type": "number", "minimum": 120, "maximum": 320 },
            "minHold": { "type": "number", "minimum": 0.5, "maximum": 5 },
            "voWpm": { "type": "number", "minimum": 100, "maximum": 200 }
          }
        },
        "subtitles": {
          "type": "object",
          "required": ["style", "position", "font", "weight", "ink"],
          "additionalProperties": false,
          "properties": {
            "style": { "enum": ["plate", "outline", "bare"] },
            "position": { "enum": ["lower", "center", "upper"] },
            "font": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]{0,31}$" },
            "weight": { "type": "number", "minimum": 100, "maximum": 1000 },
            "ink": { "$ref": "#/$defs/colorRef" },
            "plate": { "$ref": "#/$defs/colorRef" },
            "maxCharsPerLine": { "type": "integer", "minimum": 16, "maximum": 42 },
            "maxLines": { "type": "integer", "minimum": 1, "maximum": 2 }
          }
        },
        "sceneTemplates": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["title", "feature", "stat", "end-card"] } },
        "endCard": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "background": { "$ref": "#/$defs/name" },
            "logo": { "type": "boolean" }
          }
        },
        "music": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mood": { "type": "string", "minLength": 3, "maxLength": 160 },
            "bpm": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number", "minimum": 40, "maximum": 220 } },
            "energy": { "enum": ["flat", "build", "arc"] }
          }
        },
        "voice": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "casting": { "type": "string", "minLength": 3, "maxLength": 200 },
            "register": { "type": "string", "maxLength": 120 },
            "pace": { "enum": ["slow", "measured", "brisk"] },
            "accent": { "type": "string", "maxLength": 80 }
          }
        },
        "safeAreas": { "enum": ["standard", "strict"] }
      }
    },
    "illustrationSpec": {
      "type": "object",
      "required": ["style", "palette", "lighting", "background", "storyWorld", "ratio"],
      "additionalProperties": false,
      "properties": {
        "style": { "type": "string", "minLength": 3, "maxLength": 200 },
        "palette": { "type": "array", "minItems": 2, "maxItems": 6, "items": { "$ref": "#/$defs/colorRef" } },
        "lighting": { "type": "string", "minLength": 3, "maxLength": 120 },
        "background": { "type": "string", "minLength": 3, "maxLength": 160 },
        "texture": { "type": "string", "maxLength": 120 },
        "shot": { "type": "string", "maxLength": 120 },
        "storyWorld": {
          "type": "object",
          "required": ["setting", "register"],
          "additionalProperties": false,
          "properties": {
            "setting": { "type": "string", "minLength": 3, "maxLength": 200 },
            "era": { "type": "string", "maxLength": 80 },
            "cast": { "type": "string", "maxLength": 200 },
            "register": { "type": "string", "minLength": 3, "maxLength": 80 }
          }
        },
        "negatives": { "type": "array", "maxItems": 20, "items": { "type": "string", "minLength": 2, "maxLength": 120 } },
        "ratio": { "enum": ["4:3", "3:2", "16:9", "21:9", "1.91:1", "1:1", "3:4", "9:16"] }
      }
    }
  }
}

{
  "_meta": {
    "about": "JSON-LD starter templates. Replace every {{PLACEHOLDER}} or delete the property. Only mark up content visible on the page. Validate with https://search.google.com/test/rich-results and https://validator.schema.org/ before shipping.",
    "status_note": "FAQPage: Google FAQ rich results discontinued (May-June 2026); template kept only for non-Google consumers mirroring a visible FAQ. HowTo intentionally omitted (rich result removed Sept 2023).",
    "credit": "Structure informed by claude-seo v1.9.9 schema/templates.json (AgriciDaniel, MIT); rewritten and re-verified against Google Search Central, Sept 2026."
  },
  "Organization": {
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": "{{SITE_URL}}/#organization",
    "name": "{{ORG_NAME}}",
    "url": "{{SITE_URL}}/",
    "logo": {
      "@type": "ImageObject",
      "url": "{{LOGO_URL}}",
      "width": 512,
      "height": 512
    },
    "description": "{{ORG_DESCRIPTION}}",
    "email": "{{CONTACT_EMAIL}}",
    "telephone": "{{PHONE_E164}}",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "{{STREET}}",
      "addressLocality": "{{CITY}}",
      "addressRegion": "{{REGION}}",
      "postalCode": "{{POSTAL_CODE}}",
      "addressCountry": "{{COUNTRY_ISO2}}"
    },
    "contactPoint": {
      "@type": "ContactPoint",
      "contactType": "customer support",
      "email": "{{SUPPORT_EMAIL}}",
      "telephone": "{{SUPPORT_PHONE_E164}}"
    },
    "sameAs": [
      "{{LINKEDIN_URL}}",
      "{{X_URL}}",
      "{{GITHUB_URL}}",
      "{{WIKIDATA_URL}}"
    ]
  },
  "WebSite": {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": "{{SITE_URL}}/#website",
    "name": "{{SITE_NAME}}",
    "alternateName": "{{SITE_ALT_NAME}}",
    "url": "{{SITE_URL}}/",
    "inLanguage": "{{LANG_BCP47}}",
    "publisher": { "@id": "{{SITE_URL}}/#organization" }
  },
  "WebPage": {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": "{{PAGE_URL}}#webpage",
    "url": "{{PAGE_URL}}",
    "name": "{{PAGE_TITLE}}",
    "description": "{{META_DESCRIPTION}}",
    "inLanguage": "{{LANG_BCP47}}",
    "isPartOf": { "@id": "{{SITE_URL}}/#website" },
    "primaryImageOfPage": { "@type": "ImageObject", "url": "{{IMAGE_URL}}" },
    "datePublished": "{{DATE_PUBLISHED_ISO8601}}",
    "dateModified": "{{DATE_MODIFIED_ISO8601}}",
    "breadcrumb": { "@id": "{{PAGE_URL}}#breadcrumb" }
  },
  "BlogPosting": {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "@id": "{{PAGE_URL}}#article",
    "mainEntityOfPage": { "@id": "{{PAGE_URL}}#webpage" },
    "headline": "{{HEADLINE}}",
    "description": "{{SUMMARY}}",
    "image": ["{{IMAGE_16x9_URL}}", "{{IMAGE_4x3_URL}}", "{{IMAGE_1x1_URL}}"],
    "datePublished": "{{DATE_PUBLISHED_ISO8601}}",
    "dateModified": "{{DATE_MODIFIED_ISO8601}}",
    "author": [
      {
        "@type": "Person",
        "name": "{{AUTHOR_NAME}}",
        "url": "{{AUTHOR_PAGE_URL}}"
      }
    ],
    "publisher": { "@id": "{{SITE_URL}}/#organization" },
    "inLanguage": "{{LANG_BCP47}}"
  },
  "Article": {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "{{HEADLINE}}",
    "image": ["{{IMAGE_URL}}"],
    "datePublished": "{{DATE_PUBLISHED_ISO8601}}",
    "dateModified": "{{DATE_MODIFIED_ISO8601}}",
    "author": [
      { "@type": "Person", "name": "{{AUTHOR_NAME}}", "url": "{{AUTHOR_PAGE_URL}}" }
    ],
    "publisher": { "@id": "{{SITE_URL}}/#organization" }
  },
  "BreadcrumbList": {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "@id": "{{PAGE_URL}}#breadcrumb",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "{{LEVEL1_NAME}}", "item": "{{LEVEL1_URL}}" },
      { "@type": "ListItem", "position": 2, "name": "{{LEVEL2_NAME}}", "item": "{{LEVEL2_URL}}" },
      { "@type": "ListItem", "position": 3, "name": "{{CURRENT_PAGE_NAME}}" }
    ]
  },
  "Product": {
    "@context": "https://schema.org",
    "@type": "Product",
    "@id": "{{PAGE_URL}}#product",
    "name": "{{PRODUCT_NAME}}",
    "description": "{{PRODUCT_DESCRIPTION}}",
    "image": ["{{PRODUCT_IMAGE_1}}", "{{PRODUCT_IMAGE_2}}"],
    "sku": "{{SKU}}",
    "gtin13": "{{GTIN13}}",
    "brand": { "@type": "Brand", "name": "{{BRAND}}" },
    "offers": {
      "@type": "Offer",
      "url": "{{PAGE_URL}}",
      "price": "{{PRICE_DECIMAL}}",
      "priceCurrency": "{{CURRENCY_ISO4217}}",
      "availability": "https://schema.org/InStock",
      "itemCondition": "https://schema.org/NewCondition",
      "priceValidUntil": "{{DATE_ISO8601}}",
      "shippingDetails": {
        "@type": "OfferShippingDetails",
        "shippingRate": { "@type": "MonetaryAmount", "value": "{{SHIPPING_COST}}", "currency": "{{CURRENCY_ISO4217}}" },
        "shippingDestination": { "@type": "DefinedRegion", "addressCountry": "{{COUNTRY_ISO2}}" },
        "deliveryTime": {
          "@type": "ShippingDeliveryTime",
          "handlingTime": { "@type": "QuantitativeValue", "minValue": 0, "maxValue": 1, "unitCode": "DAY" },
          "transitTime": { "@type": "QuantitativeValue", "minValue": 1, "maxValue": 5, "unitCode": "DAY" }
        }
      },
      "hasMerchantReturnPolicy": {
        "@type": "MerchantReturnPolicy",
        "applicableCountry": "{{COUNTRY_ISO2}}",
        "returnPolicyCountry": "{{COUNTRY_ISO2}}",
        "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
        "merchantReturnDays": 30,
        "returnMethod": "https://schema.org/ReturnByMail",
        "returnFees": "https://schema.org/FreeReturn"
      }
    },
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "{{AVG_RATING_REAL_ONLY}}",
      "reviewCount": "{{REVIEW_COUNT_REAL_ONLY}}",
      "bestRating": "5",
      "worstRating": "1"
    }
  },
  "LocalBusiness": {
    "@context": "https://schema.org",
    "@type": "{{MOST_SPECIFIC_SUBTYPE_eg_Dentist}}",
    "@id": "{{LOCATION_PAGE_URL}}#localbusiness",
    "name": "{{BUSINESS_NAME_AS_ON_SIGNAGE}}",
    "url": "{{LOCATION_PAGE_URL}}",
    "image": ["{{STOREFRONT_PHOTO_URL}}"],
    "telephone": "{{PHONE_E164}}",
    "priceRange": "{{PRICE_RANGE_UNDER_100_CHARS}}",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "{{STREET}}",
      "addressLocality": "{{CITY}}",
      "addressRegion": "{{REGION}}",
      "postalCode": "{{POSTAL_CODE}}",
      "addressCountry": "{{COUNTRY_ISO2}}"
    },
    "geo": { "@type": "GeoCoordinates", "latitude": "{{LAT_5DP}}", "longitude": "{{LNG_5DP}}" },
    "openingHoursSpecification": [
      {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
        "opens": "09:00",
        "closes": "17:00"
      }
    ],
    "areaServed": ["{{CITY_OR_REGION}}"],
    "parentOrganization": { "@id": "{{SITE_URL}}/#organization" },
    "sameAs": ["{{GBP_MAPS_URL}}"]
  },
  "FAQPage": {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "_note": "No Google rich result (discontinued 2026). Use only to mirror a visible FAQ; remove this _note key before use.",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "{{QUESTION_1}}",
        "acceptedAnswer": { "@type": "Answer", "text": "{{ANSWER_1}}" }
      },
      {
        "@type": "Question",
        "name": "{{QUESTION_2}}",
        "acceptedAnswer": { "@type": "Answer", "text": "{{ANSWER_2}}" }
      }
    ]
  },
  "SoftwareApplication": {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "{{APP_NAME}}",
    "description": "{{APP_DESCRIPTION}}",
    "url": "{{PAGE_URL}}",
    "applicationCategory": "BusinessApplication",
    "operatingSystem": "{{OS_eg_Web_Windows_macOS}}",
    "offers": {
      "@type": "Offer",
      "price": "{{PRICE_OR_0}}",
      "priceCurrency": "{{CURRENCY_ISO4217}}"
    },
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "{{AVG_RATING_REAL_ONLY}}",
      "ratingCount": "{{RATING_COUNT_REAL_ONLY}}"
    },
    "publisher": { "@id": "{{SITE_URL}}/#organization" }
  },
  "Event": {
    "@context": "https://schema.org",
    "@type": "Event",
    "name": "{{EVENT_NAME}}",
    "description": "{{EVENT_DESCRIPTION}}",
    "startDate": "{{START_ISO8601_WITH_OFFSET}}",
    "endDate": "{{END_ISO8601_WITH_OFFSET}}",
    "eventStatus": "https://schema.org/EventScheduled",
    "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
    "image": ["{{EVENT_IMAGE_MIN_720W}}"],
    "location": {
      "@type": "Place",
      "name": "{{VENUE_NAME}}",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "{{STREET}}",
        "addressLocality": "{{CITY}}",
        "addressRegion": "{{REGION}}",
        "postalCode": "{{POSTAL_CODE}}",
        "addressCountry": "{{COUNTRY_ISO2}}"
      }
    },
    "offers": {
      "@type": "Offer",
      "url": "{{TICKET_URL}}",
      "price": "{{PRICE_DECIMAL}}",
      "priceCurrency": "{{CURRENCY_ISO4217}}",
      "availability": "https://schema.org/InStock",
      "validFrom": "{{SALE_START_ISO8601}}"
    },
    "organizer": { "@type": "Organization", "name": "{{ORGANIZER_NAME}}", "url": "{{ORGANIZER_URL}}" }
  },
  "Person": {
    "@context": "https://schema.org",
    "@type": "ProfilePage",
    "dateCreated": "{{DATE_ISO8601}}",
    "dateModified": "{{DATE_ISO8601}}",
    "mainEntity": {
      "@type": "Person",
      "@id": "{{AUTHOR_PAGE_URL}}#person",
      "name": "{{PERSON_NAME}}",
      "url": "{{AUTHOR_PAGE_URL}}",
      "image": "{{HEADSHOT_URL}}",
      "jobTitle": "{{JOB_TITLE}}",
      "description": "{{SHORT_BIO}}",
      "worksFor": { "@id": "{{SITE_URL}}/#organization" },
      "knowsAbout": ["{{TOPIC_1}}", "{{TOPIC_2}}"],
      "sameAs": ["{{LINKEDIN_URL}}", "{{PERSONAL_SITE_URL}}"]
    }
  },
  "VideoObject": {
    "@context": "https://schema.org",
    "@type": "VideoObject",
    "name": "{{VIDEO_TITLE}}",
    "description": "{{VIDEO_DESCRIPTION}}",
    "thumbnailUrl": ["{{THUMBNAIL_URL}}"],
    "uploadDate": "{{UPLOAD_ISO8601_WITH_OFFSET}}",
    "duration": "{{ISO8601_DURATION_eg_PT4M30S}}",
    "contentUrl": "{{VIDEO_FILE_URL}}",
    "embedUrl": "{{EMBED_URL}}",
    "hasPart": [
      {
        "@type": "Clip",
        "name": "{{CHAPTER_1_NAME}}",
        "startOffset": 0,
        "endOffset": 45,
        "url": "{{PAGE_URL}}?t=0"
      }
    ]
  }
}
